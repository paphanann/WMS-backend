# Server
PORT=3001
HOST=0.0.0.0

# SQL Server = ฐานของเรา
# DB_AUTH=windows ใช้ Windows Authentication (แนะนำตอน local)
# DB_AUTH=sql     ใช้ SQL Auth ด้วย DB_USER / DB_PASSWORD
DB_AUTH=windows
DB_SERVER=localhost
DB_PORT=1433
DB_DATABASE=WMS_DATABASE
DB_USER=manager
DB_PASSWORD=P@ss2025

# SAP B1 = บริษัท SAP (Service Layer) ใช้ WMS_W9
SAP_ENABLED=true
SAP_BASE_URL=https://127.0.0.1:50000/b1s/v1
SAP_COMPANY_DB=WMS_W9
SAP_USERNAME=manager
SAP_PASSWORD=1111
